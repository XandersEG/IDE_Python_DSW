<Window x:Class="IDEPython.IDE"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IDE" Height="820" Width="1550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" KeyDown="Window_KeyDown" VerticalAlignment="Center"
        WindowStyle="None" WindowState="Maximized" Topmost="True">

    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#3F4185"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallRoundDanger" TargetType="Button">
            <Setter Property="Background" Value="#FFECEC"/>
            <Setter Property="Foreground" Value="#C0392B"/>
            <Setter Property="BorderBrush" Value="#E6B0AA"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de herramientas superior -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FF635C5C">
            <Button x:Name="btnShowFiles" Content="📁" Width="30" Height="24" Background="#FFF6F676" Foreground="Black" Click="btnShowFiles_Click" Margin="10,0,0,0" FontWeight="Bold" ToolTip="Mostrar/esconder archivos"/>
            <Button x:Name="btnSaveFiles" Content="💾" Width="30" Height="24" Background="DarkBlue" Foreground="Black" Click="btnSaveFiles_Click" Margin="10,0,0,0" FontWeight="Bold" ToolTip="Guardar archivo (CTRL+S)"/>
            <Button x:Name="btnRun" Content="▶" Width="25" Height="25" Background="#FF7CFF8D" Margin="10,0,10,0" Click="btnRun_Click" ToolTip="Iniciar ejecución (F5 o CTRL+R)"/>
            <Button x:Name="btnStop" Content="⯃" Width="25" Height="25" Background="#FFE36565" Margin="0,0,10,0" Click="btnStop_Click" ToolTip="Detener ejecución"/>
            <Button x:Name="btnTerminal" Content=">_" Width="25" Height="25" Background="#FF201D1D" Margin="0,0,10,0" Click="btnTerminal_Click" Foreground="White" ToolTip="Abrir terminal de Python"/>
            <Label x:Name="lblProjectName" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="1100"/>

            <Grid Width="296" Margin="0,0,0,0" RenderTransformOrigin="0.811,0.526">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="235,0,0,0" Width="38">
                    <Button x:Name="btnReturn" Content="x" Width="30" Height="24" Background="#FFFF1A45" Foreground="White" Click="btnReturn_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Área de trabajo principal -->
        <Grid Grid.Row="1" Background="#FF352D2D">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colPadding" Width="20"/>
                <ColumnDefinition x:Name="colFiles" Width="340" MinWidth="340"/>
                <ColumnDefinition x:Name="colSplitter" Width="3"/>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Explorador de Archivos y Paneles Laterales -->
            <Border x:Name="spFiles" Grid.Row="0" Grid.Column="0" Background="#2E2E2E" Padding="8" Grid.ColumnSpan="2">
                <StackPanel>
                    <TextBlock Text="Archivos" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="btnNewFile" Content="Nuevo archivo" Width="90" Height="24" Click="btnNewFile_Click" Margin="0,0,6,0"/>
                        <Button x:Name="btnNewFolder" Content="Nueva carpeta" Width="95" Height="24" Click="btnNewFolder_Click" Margin="0,0,6,0"/>
                        <Button x:Name="btnDelete" Content="Eliminar" Width="65" Height="24" Click="btnDelete_Click"/>
                    </StackPanel>

                    <ScrollViewer Height="100" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        <TreeView x:Name="tvFiles" Foreground="White" BorderThickness="0" SelectedItemChanged="tvFiles_SelectedItemChanged" BorderBrush="#FF0B57E0"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="tvFiles_PreviewMouseLeftButtonDown"
                                  MouseMove="tvFiles_MouseMove"
                                  Drop="tvFiles_Drop"
                                  DragOver="tvFiles_DragOver"
                                  PreviewKeyDown="tvFiles_PreviewKeyDown"
                                  MouseDoubleClick="tvFiles_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="tvFiles_PreviewMouseRightButtonDown"
                                  ContextMenuOpening="tvFiles_ContextMenuOpening"/>
                    </ScrollViewer>

                    <Border x:Name="homeWorklist" Background="White" CornerRadius="20" Margin="0,30,0,0" Height="420" MaxHeight="450">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" Direction="270" ShadowDepth="4" Opacity="0.2"/>
                        </Border.Effect>

                        <Grid Margin="15">
                            <Grid x:Name="pnlCursosSeccion" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Mis Cursos" FontSize="16" FontWeight="Bold" Foreground="#3F4185" Margin="5,0,0,10"/>

                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ListBox x:Name="lbCursos" Background="Transparent" BorderThickness="0" SelectionChanged="LbCursos_SelectionChanged" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#ECECFF" CornerRadius="8" Width="270" Height="65" Padding="12,10" Margin="5,0,5,8" BorderBrush="#3F4185" BorderThickness="1" HorizontalAlignment="Left">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#3F4185" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Code}" Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="pnlTareasSeccion" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" Content="◀ Volver a Cursos" Click="BtnVolverCursos_Click" Background="Transparent" Foreground="#3F4185" BorderThickness="0" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,5"/>

                                <TextBlock Grid.Row="1" x:Name="lblCursoSeleccionadoTitulo" Text="Tareas del Curso" FontSize="15" FontWeight="Bold" Foreground="#2E3066" Margin="5,5,0,10"/>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                    <ItemsControl x:Name="icTareas">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="5,0,5,10" Background="WhiteSmoke" BorderBrush="#ECECFF" BorderThickness="1" CornerRadius="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="15,10">
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#3F4185"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Ver" Background="#5B5EC7" Foreground="White" Width="55" Height="28" Margin="10,0" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnVerEnunciado_Click" Tag="{Binding}">
                                                            <Button.Resources>
                                                                <Style TargetType="{x:Type Border}">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Panel de Detalle del Enunciado -->
                    <Border x:Name="pnlEnunciado" Background="#1E1E2E" CornerRadius="12" Margin="0,10,0,0" Padding="15" Visibility="Collapsed" Height="350" MaxHeight="350">
                        <DockPanel LastChildFill="True">

                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Enunciado" FontWeight="Bold" FontSize="14" Foreground="#A0A3FF" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <Button x:Name="btnCerrarEnunciado" Content="✕" DockPanel.Dock="Right" HorizontalAlignment="Right" Width="24" Height="24" Background="Transparent" Foreground="#A0A3FF" BorderThickness="0" Cursor="Hand" Click="BtnCerrarEnunciado_Click"/>
                            </DockPanel>

                            <Button x:Name="BtnUploadProject" Content="Entregar este proyecto" Background="#2ECC71" Foreground="White" Height="32" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnUploadProject_Click" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" x:Name="lblEnunciadoTitulo" FontSize="14" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" x:Name="lblEnunciadoDeadline" FontSize="11" Foreground="#FF9A9A" Margin="0,0,0,8"/>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                    <TextBlock x:Name="lblEnunciadoDescripcion" FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap" LineHeight="20"/>
                                </ScrollViewer>
                            </Grid>

                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Separador Vertical para el Explorador de Archivos -->
            <GridSplitter x:Name="filesSplitter" Grid.Row="0" Grid.Column="2" Width="5" 
                          HorizontalAlignment="Center" 
                          Background="Transparent" ShowsPreview="True" 
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <!-- Números de Línea -->
            <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtLineNumbers"
                     Background="#FF3C3C3C" Foreground="White" BorderThickness="0"
                     IsReadOnly="True" TextAlignment="Center" FontFamily="Consolas" FontSize="14"
                     Padding="0,10,0,0" VerticalScrollBarVisibility="Hidden"/>

            <!-- Editor de Código Principal -->
            <TextBox Grid.Row="0" Grid.Column="4" x:Name="txtEditor"
                     Background="#FF8E8E8E" Foreground="White" BorderThickness="0"
                     AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="14"
                     Padding="10,10,0,0" VerticalScrollBarVisibility="Auto"
                     Text="Write your code here..." GotFocus="txtEditor_Click" 
                     DataObject.Pasting="txtEditor_Pasting" DataObject.Copying="txtEditor_Copying" TextChanged="txtEditor_TextChanged"/>

            <!-- Separador Horizontal para la Consola -->
            <GridSplitter x:Name="txtConsoleSeparator" Grid.Row="1" Grid.ColumnSpan="5" Height="5" 
                          HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Black"
                          IsEnabled="False"/>

            <!-- Salida de Consola -->
            <TextBox Grid.Row="2" Grid.ColumnSpan="5" x:Name="txtConsole"
            Background="Black" FontFamily="Consolas" FontSize="12"
            IsReadOnly="True"  IsReadOnlyCaretVisible="True"
AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="10" Height="120" MinHeight="120" MaxHeight="120" Focusable="False" />

            <StackPanel Grid.Row="3" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,4,0,-4" Visibility="Collapsed" x:Name="spConsoleInput">
                <TextBox x:Name="txtConsoleInput" Width="1450" Height="28" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" KeyDown="txtConsoleInput_KeyDown" AcceptsTab="True"/>
                <Button x:Name="btnConsoleSend" Content="Enviar" Width="80" Height="28" Margin="8,0,0,0" Click="btnConsoleSend_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
