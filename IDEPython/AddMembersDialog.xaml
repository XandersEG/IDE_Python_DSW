<Window x:Class="IDEPython.AddMembersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IDEPython"
        mc:Ignorable="d"
        Title="Grupo de Trabajo" Height="250" Width="400">
    <Border CornerRadius="8" Background="#FF1E1E1E" BorderBrush="#FF3A3A3A" BorderThickness="1" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Añadir Miembro a la Tarea" FontSize="16" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="1" Margin="0,5,0,0">

                <TextBlock x:Name="txtFileName" 
                           Text="Archivo.py" 
                           Foreground="#FF007ACC" FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,15" 
                           TextWrapping="Wrap" />

                <TextBlock Text="Correo electrónico del miembro:" Foreground="#FF888888" FontSize="12" Margin="0,0,0,6" />

                <TextBox x:Name="txtEmail" 
                         Height="32" 
                         Background="#FF2D2D2D" 
                         Foreground="White" 
                         BorderBrush="#FF3A3A3A" 
                         BorderThickness="1" 
                         Padding="6,4" 
                         VerticalContentAlignment="Center"
                         CaretBrush="White">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="btnSave" Width="90" Height="30" Margin="4" Background="#FF007ACC" Foreground="White" Content="Añadir" Click="btnSave_Click" />
                <Button x:Name="btnCancel" Width="90" Height="30" Margin="4" Background="#FF5A5A5A" Foreground="White" Content="Cancelar" Click="btnCancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>