<Window x:Class="IDEPython.SaveChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardar cambios" Height="180" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="8" Background="#FF1E1E1E" BorderBrush="#FF3A3A3A" BorderThickness="1" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="¿Deseas guardar los cambios?" FontSize="16" Foreground="White" FontWeight="Bold" />
            <TextBlock x:Name="txtFileName" Grid.Row="1" Text="Archivo.py" Foreground="#FFCCCCCC" Margin="0,10,0,0" TextWrapping="Wrap" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="btnSave" Width="90" Height="30" Margin="4" Background="#FF007ACC" Foreground="White" Content="Guardar" Click="btnSave_Click" />
                <Button x:Name="btnDontSave" Width="90" Height="30" Margin="4" Background="#FF3A3A3A" Foreground="White" Content="No guardar" Click="btnDontSave_Click" />
                <Button x:Name="btnCancel" Width="90" Height="30" Margin="4" Background="#FF5A5A5A" Foreground="White" Content="Cancelar" Click="btnCancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>